# ------------------------------------------------------------------
# ChessGuideX — Environment Variables
# Copy to .env.local and fill in real values.
# ------------------------------------------------------------------

# Supabase — transaction pooler (Prisma Client uses this at runtime).
# NOTE: sslmode must NOT go here — node-postgres treats it as strict
# verify-full which fails on Supabase's cert chain. TLS is enabled in
# src/lib/db.ts via ssl: { rejectUnauthorized: false }.
DATABASE_URL="YOUR-DATABASE-URL"

# Supabase — direct connection (Prisma CLI only: migrate, generate, etc.)
DIRECT_URL="YOUR-DIRECT-URL"
# Supabase — project credentials
NEXT_PUBLIC_SUPABASE_URL="YOUR-NEXT-PUBLIC-SUPABASE-URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# Public origin used for auth redirect links (email confirmation).
# Change to your deployed domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
