# ------------------------------------------------------------------
# ChessGuideX — Environment Variables
# Copy to .env.local and fill in real values.
# ------------------------------------------------------------------

# Supabase — transaction pooler (Prisma Client uses this at runtime)
DATABASE_URL="YOUR-SUPABASE-DATABASE-URL"

# Supabase — direct connection (Prisma CLI only: migrate, generate, etc.)
DIRECT_URL="YOUR-SUPABASE-DIRECT-URL"
# Supabase — project credentials
NEXT_PUBLIC_SUPABASE_URL="YOUR-NEXT-PUBLIC-SUPABASE-URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
